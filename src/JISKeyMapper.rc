#include <windows.h>

// Icon IDs
// 1 = application icon (no badge) -- Windows uses ID=1 as the EXE icon
// 2 = tray ON  for JP-keyboard mode (OS=US,  label JP, green badge)
// 3 = tray OFF for JP-keyboard mode (OS=US,  label JP, gray  badge)
// 4 = tray ON  for US-keyboard mode (OS=JIS, label US, green badge)
// 5 = tray OFF for US-keyboard mode (OS=JIS, label US, gray  badge)
1 ICON "res/app.ico"
2 ICON "res/on_jp.ico"
3 ICON "res/off_jp.ico"
4 ICON "res/on_us.ico"
5 ICON "res/off_us.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "JIS Keyboard Mapper"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "ProductName",      "JISKeyMapper"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
