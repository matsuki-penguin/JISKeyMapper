{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "msvc: build active file",
            "command": "cmd.exe",
            "args": [
                "/c",
                // 展開した Build Tools の vcvars64.bat への絶対パスを指定してください
                "\"C:\\path\\to\\setup_x64.bat\" && nmake.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}